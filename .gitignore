# Dependencies
node_modules/
/.pnp
.pnp.js

# Production build artifacts
dist/
dist-ssr/
build/
*.local

# Environment files (preserve templates)
.env
.env*.local
!.env.example
jansetu-backend/.env
jansetu-backend/.env*.local
!jansetu-backend/.env.example

# Python cache & test artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
venv/
.venv/
env/
ENV/

# Local databases
*.db
*.sqlite3
jansetu-backend/*.db
jansetu-backend/*.sqlite3

# Uploads directory contents (except .gitkeep)
jansetu-backend/uploads/*
!jansetu-backend/uploads/.gitkeep

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
