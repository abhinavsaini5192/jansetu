# JanSetu Platform Environment Variables
APP_NAME="JanSetu Backend"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database Configuration (PostgreSQL primary)
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/jansetu
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Optional individual database components (if not using full DATABASE_URL):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=jansetu
# DB_USER=postgres
# DB_PASSWORD=password

# Security & Authentication
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production_jansetu_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
